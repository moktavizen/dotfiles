#!/usr/bin/env bash

selected="${1:-$(find /home ~/ ~/Projects/ ~/Courses/the-odin-project/odin-tracker/ \
  -mindepth 1 -maxdepth 1 -type d | fzf --preview 'eza -1 --icons=always --color=always {}')}"

[[ -z $selected ]] && exit 0

selected_name=$(basename "$selected" | tr . _)

if [[ -z $TMUX ]]; then
  exec tmux new-session -A -s "$selected_name" -c "$selected"
else
  tmux new-session -ds "$selected_name" -c "$selected" 2>/dev/null
  exec tmux switch-client -t "$selected_name"
fi

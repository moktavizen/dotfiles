[credential "https://github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
[init]
	defaultBranch = main
[pull]
	rebase = false

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    dark = true

    # Theme
    syntax-theme                  = base16
    minus-style                   = syntax "#3a2b2c"
    minus-non-emph-style          = syntax "#3a2b2c"
    minus-emph-style              = syntax "#724d4f"
    minus-empty-line-marker-style = syntax "#3a2b2c"
    plus-style                    = syntax "#3b4133"
    plus-non-emph-style           = syntax "#3b4133"
    plus-emph-style               = syntax "#687754"
    plus-empty-line-marker-style  = syntax "#3b4133"

[merge]
    conflictStyle = zdiff3
